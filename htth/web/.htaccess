RewriteEngine On
RewriteBase /
# Chuyển đổi các yêu cầu không phải là tệp hoặc thư mục thành .php theo đường dẫn gốc
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([^/]+)/?$ $1.php [L]

# Chuyển hướng trang Home đến file Index.php
RewriteRule ^Home$ /Index.php [L]

# Chuyển hướng các URL liên quan đến đăng nhập và đăng ký
RewriteRule ^Auth/Login$ /Public/Auth/Login.php [L]
RewriteRule ^Auth/Register$ /Public/Auth/Register.php [L]
RewriteRule ^Auth/Logout$ /Public/Auth/Logout.php [L]
RewriteRule ^Auth/Forgot-Password$ /Public/Auth/Forgot-Password.php [L]

# Chuyển hướng các URL liên quan đến tài khoản người dùng
RewriteRule ^Users/Profile$ /Public/Users/Profile.php [L]
RewriteRule ^Users/Payment$ /Public/Users/Payment.php [L]
RewriteRule ^Users/Member$ /Public/Users/Member.php [L]
RewriteRule ^Users/Gold$ /Public/Users/Gold.php [L]
RewriteRule ^Users/ChangePassword$ /Public/Users/ChangePassword.php [L]
RewriteRule ^Users/Downloads$ /Public/Other/Downloads.php [L]
RewriteRule ^Users/Forum$ /Public/Other/Forum.php [L]
RewriteRule ^Users/Post$ /Public/Other/Post.php [L]
RewriteRule ^Users/Info$ /Public/Other/Info.php [L]
RewriteRule ^Users/Rankings$ /Public/Other/Rankings.php [L]

#Api
RewriteRule ^Api/Login$ /Api/Auth/Login.php [L]
RewriteRule ^Api/Register$ /Api/Auth/Register.php [L]
RewriteRule ^Api/Post$ /Api/Users/Forum.php [L]
RewriteRule ^Api/Comments$ /Api/Users/Comments.php [L]
RewriteRule ^Api/LoadPost$ /Api/Users/LoadPost.php [L]
RewriteRule ^Api/Active$ /Api/Users/Active.php [L]
RewriteRule ^Api/Password$ /Api/Users/Password.php [L]
RewriteRule ^Api/Callback$ /Api/Users/Callback.php [L]
RewriteRule ^Api/CronAcb$ /Api/Bank/CronAcb.php [L]
RewriteRule ^Api/Card$ /Api/Users/Card.php [L]
RewriteCond %{REQUEST_URI} !^/Public/Downloads/ [NC]
RewriteRule ^Downloads/(.*)$ /Public/Downloads/$1 [L]

# Chuyển hướng đến trang Index.php khi file không tồn tại
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.*)$ /Index.php [L]

# Chuyển hướng đến trang error.php khi file không tồn tại
ErrorDocument 404 /Home

# Tắt truy cập vào thư mục
Options -Indexes

# Thêm loại tệp .IPA
AddType application/octet-stream .ipa

# Bảo vệ tệp .htaccess
<Files .htaccess>
    order allow,deny
    deny from all
</Files>

<FilesMatch "\.(jpg|jpeg|png|gif|svg|css|js)$">
    Header set Cache-Control "max-age=31536000"
</FilesMatch>
